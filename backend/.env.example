# =============================================================================
# MilesAi 后端环境变量模板
# 使用方式：cp .env.example .env 后按环境修改
# 加载顺序（见 app/core/config.py）：backend/.env → 项目根目录 ../.env
# =============================================================================

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=MilesAi
APP_ENV=development
# 生产环境务必设为 false
DEBUG=true
# 生产环境请替换：openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# JWT 认证
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL（业务库）
# Docker：POSTGRES_HOST=postgres | 本地：POSTGRES_HOST=localhost
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=milesai

# 连接池（默认 5+10=15，与 SQLAlchemy 默认一致）。
# 对话/生成链路的事务会跨越 LLM 调用，并发高时需调大；pool_timeout 单位秒。
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis（缓存 / 会话 / Celery Broker）
# Docker：REDIS_HOST=redis | 本地：REDIS_HOST=localhost
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# LangGraph checkpoint（须 Redis Stack / Redis 8+；RediSearch 索引仅支持 db=0）
# 普通 Redis 或 db!=0 会回退 MemorySaver，详见 docs/langgraph-rag-workflow.md
LANGGRAPH_REDIS_DB=0
LANGGRAPH_REDIS_CHECKPOINT=true

# -----------------------------------------------------------------------------
# 对象存储（S3 兼容 API；MinIO / OSS / AWS S3）
# Docker：OBJECT_STORAGE_ENDPOINT=minio:9000 | 本地：localhost:9000
# -----------------------------------------------------------------------------
# --- MinIO 默认配置 ---
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=milesai
OBJECT_STORAGE_SECURE=false
# --- 阿里云 OSS 配置示例 ---
# 注意：
# 1. Endpoint 必须用 S3 兼容格式：s3.oss-{region}.aliyuncs.com（不是 oss-{region}.aliyuncs.com）
# 2. Region 必填，否则 SDK 会自动调 GetBucketLocation 导致 AccessDenied
# 3. 需在 OSS 控制台开启「S3 兼容 API」功能
# 4. 2025/3/20 起新用户中国大陆 bucket 需绑定自定义 CNAME 域名
# OBJECT_STORAGE_ENDPOINT=s3.oss-cn-shenzhen.aliyuncs.com
# OBJECT_STORAGE_ACCESS_KEY=LTAI5txxx
# OBJECT_STORAGE_SECRET_KEY=xxx
# OBJECT_STORAGE_BUCKET=scidesign
# OBJECT_STORAGE_SECURE=true
# OBJECT_STORAGE_REGION=cn-shenzhen
# --- AWS S3 配置示例 ---
# OBJECT_STORAGE_ENDPOINT=s3.amazonaws.com
# OBJECT_STORAGE_ACCESS_KEY=AKIAxxx
# OBJECT_STORAGE_SECRET_KEY=xxx
# OBJECT_STORAGE_BUCKET=my-bucket
# OBJECT_STORAGE_SECURE=true
# OBJECT_STORAGE_REGION=us-east-1

# -----------------------------------------------------------------------------
# 向量存储（测试环境默认 Milvus；可选 weaviate / pgvector）
# Docker：MILVUS_URI=http://milvus:19530 | 本地：http://localhost:19530
# -----------------------------------------------------------------------------
VECTOR_STORE_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
# pgvector 需：CREATE EXTENSION IF NOT EXISTS vector;
# VECTOR_STORE_BACKEND=weaviate
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080
# WEAVIATE_SCHEME=http
# Docker 使用 milvus 时：MILVUS_URI=http://milvus:19530

# -----------------------------------------------------------------------------
# Celery 异步任务
# 需与 Redis 地址一致；Docker 内使用服务名 redis
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 任务超时（秒）：全局默认 3600/3660；ingest 1800/1860；生图/生视频 7200/7260
# CELERY_TASK_SOFT_TIME_LIMIT_SEC=3600
# CELERY_TASK_TIME_LIMIT_SEC=3660
# CELERY_INGEST_SOFT_TIME_LIMIT_SEC=1800
# CELERY_INGEST_TIME_LIMIT_SEC=1860
# CELERY_GENERATIVE_SOFT_TIME_LIMIT_SEC=7200
# CELERY_GENERATIVE_TIME_LIMIT_SEC=7260

# -----------------------------------------------------------------------------
# OpenTelemetry OTLP 导出（默认关闭；依赖随 miles-server 一并安装，启用需配置 endpoint）
# 当前实现为 gRPC OTLP（非 HTTP 4318），Collector 常见端口 4317
# -----------------------------------------------------------------------------
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=milesai-api

# -----------------------------------------------------------------------------
# CORS（前端地址，逗号分隔）
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
# 是否允许跨域携带凭证；本项目认证走 Bearer Header、不用 Cookie，保持 false
CORS_ALLOW_CREDENTIALS=false

# -----------------------------------------------------------------------------
# RAG / Embedding
# -----------------------------------------------------------------------------
# 向量化后端：local（本地 Sentence-Transformers）| litellm（云端 API）
EMBEDDING_BACKEND=local
# --- local（默认，768 维 BGE 中文，无需 API Key）---
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_VECTOR_DIMENSION=768
# --- litellm（示例：通义 embedding；新建 KB 请设 1024 并重建已有索引）---
# EMBEDDING_BACKEND=litellm
# EMBEDDING_LITELLM_MODEL=dashscope/text-embedding-v4
# EMBEDDING_LITELLM_API_KEY=
# 也可不配此项，改用厂商环境变量：DASHSCOPE_API_KEY
# EMBEDDING_LITELLM_API_BASE=
# EMBEDDING_VECTOR_DIMENSION=1024

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# 文档解析（入库 Parse）
# pypdf：默认，无额外依赖 | docling：PDF/Office 版式（pip install 'milesai[parse-docling]'）
# -----------------------------------------------------------------------------
# PARSE_PDF_BACKEND=pypdf
# PARSE_PDF_BACKEND=docling
# PARSE_DOCLING_FALLBACK_PYPDF=true

# -----------------------------------------------------------------------------
# 大模型调用（LiteLLM）
# 对话类模型（llm / reasoning / vision）经 litellm.acompletion；
# API Key 优先来自租户「模型供应商」配置，下列环境变量为 LiteLLM 兜底。
# LITELLM_LOG=ERROR 可抑制未安装 botocore 时的 Bedrock/SageMaker 预加载警告
# -----------------------------------------------------------------------------
# LITELLM_LOG=ERROR
#
# 向量化 invoke_mode（ModelConfig.extra，知识库绑定的 embedding 模型）：
#   local              — Sentence-Transformers（如 BGE）
#   openai_compatible  — OpenAI /v1/embeddings（DashScope compatible-mode 等）
#   litellm            — LiteLLM 已正式支持的 embedding provider
# embedding_batch_size — 单次 /embeddings 请求条数；通义 DashScope 上限 10（未配置时自动按 vendor 限制）
#
# rerank invoke_mode（ModelConfig.extra，重排模型）：
#   dashscope          — DashScope 原生 text-rerank API（通义 qwen3-rerank 默认）
#   openai_compatible  — OpenAI /v1/reranks（DashScope compatible-api）
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# VOLCENGINE_API_KEY=
# ARK_API_KEY=
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 首次启动种子数据（仅库中无 admin 用户时写入）
# 生产环境请修改默认密码
# -----------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@local.dev
SEED_TENANT_NAME=默认租户

# =============================================================================
# Docker 应用栈（docker-compose.yml）内使用服务名：
#   POSTGRES_HOST=postgres
#   REDIS_HOST=redis
#   OBJECT_STORAGE_ENDPOINT=minio:9000
#   WEAVIATE_HOST=weaviate
#   CELERY_BROKER_URL=redis://redis:6379/1
#   CELERY_RESULT_BACKEND=redis://redis:6379/2
#
# 先启动中间件：docker compose -f docker-compose.infra.yml up -d
# =============================================================================
