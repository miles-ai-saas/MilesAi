# =============================================================================
# MilesAi 后端环境变量模板
# 使用方式：cp .env.example .env 后按环境修改
# 加载顺序（见 app/core/config.py）：backend/.env → 项目根目录 ../.env
# =============================================================================

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=MilesAi
APP_ENV=development
# 生产环境务必设为 false
DEBUG=true
# 生产环境请替换：openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# JWT 认证
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL（业务库）
# Docker：POSTGRES_HOST=postgres | 本地：POSTGRES_HOST=localhost
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=milesai

# -----------------------------------------------------------------------------
# Redis（缓存 / 会话 / Celery Broker）
# Docker：REDIS_HOST=redis | 本地：REDIS_HOST=localhost
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# LangGraph checkpoint（须 Redis Stack / Redis 8+；RediSearch 索引仅支持 db=0）
# 普通 Redis 或 db!=0 会回退 MemorySaver，详见 docs/langgraph-rag-workflow.md
LANGGRAPH_REDIS_DB=0
LANGGRAPH_REDIS_CHECKPOINT=true

# -----------------------------------------------------------------------------
# MinIO（对象存储，S3 兼容）
# Docker：MINIO_ENDPOINT=minio:9000 | 本地：localhost:9000
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=milesai
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Weaviate（向量库）
# Docker：WEAVIATE_HOST=weaviate | 本地：localhost
# -----------------------------------------------------------------------------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http

# -----------------------------------------------------------------------------
# Celery 异步任务
# 需与 Redis 地址一致；Docker 内使用服务名 redis
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# CORS（前端地址，逗号分隔）
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# -----------------------------------------------------------------------------
# RAG / Embedding
# -----------------------------------------------------------------------------
# 向量化后端：local（本地 Sentence-Transformers）| litellm（云端 API）
EMBEDDING_BACKEND=local
# --- local（默认，384 维，无需 API Key）---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIMENSION=384
# --- litellm（示例：通义 embedding；新建 KB 请设 1024 并重建已有索引）---
# EMBEDDING_BACKEND=litellm
# EMBEDDING_LITELLM_MODEL=dashscope/text-embedding-v3
# EMBEDDING_LITELLM_API_KEY=
# 也可不配此项，改用厂商环境变量：DASHSCOPE_API_KEY
# EMBEDDING_LITELLM_API_BASE=
# EMBEDDING_VECTOR_DIMENSION=1024

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# 大模型调用（LiteLLM）
# 对话类模型（llm / reasoning / vision）经 litellm.acompletion；
# API Key 优先来自租户「模型供应商」配置，下列环境变量为 LiteLLM 兜底。
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# VOLCENGINE_API_KEY=
# ARK_API_KEY=
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 首次启动种子数据（仅库中无 admin 用户时写入）
# 生产环境请修改默认密码
# -----------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@local.dev
SEED_TENANT_NAME=默认租户

# =============================================================================
# Docker 应用栈（docker-compose.yml）内使用服务名：
#   POSTGRES_HOST=postgres
#   REDIS_HOST=redis
#   MINIO_ENDPOINT=minio:9000
#   WEAVIATE_HOST=weaviate
#   CELERY_BROKER_URL=redis://redis:6379/1
#   CELERY_RESULT_BACKEND=redis://redis:6379/2
#
# 先启动中间件：docker compose -f docker-compose.middleware.yml up -d
# =============================================================================
