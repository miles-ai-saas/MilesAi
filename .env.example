# =============================================================================
# MilesAi 项目根目录环境变量（Docker Compose）
# 基础设施：docker-compose.infra.yml
# 应用：  docker-compose.yml
# 本地仅跑后端：backend/.env.example → backend/.env
# =============================================================================

# Compose 宿主机端口（可选）
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# OBJECT_STORAGE_PORT=9000
# OBJECT_STORAGE_CONSOLE_PORT=9001
# WEAVIATE_PORT=8080
# API_PORT=8000
# WEB_PORT=3000
# ADMIN_WEB_PORT=3001
# FLOWER_PORT=5555
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000/api/admin/v1
# NEXT_PUBLIC_TENANT_WEB_URL=http://localhost:3000

# 应用
APP_NAME=MilesAi
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL（Compose 服务名）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=milesai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 对象存储（S3 兼容）
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=milesai
OBJECT_STORAGE_SECURE=false

# 向量存储（Docker 全栈默认 Milvus；本地仅跑后端见 backend/.env.example）
VECTOR_STORE_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
# 备用 Weaviate：
# VECTOR_STORE_BACKEND=weaviate
# WEAVIATE_HOST=weaviate
# WEAVIATE_PORT=8080
# WEAVIATE_SCHEME=http

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OpenTelemetry OTLP 导出（可选，需 pip install 'milesai[otel]'；默认关闭）
# 当前实现为 gRPC OTLP（非 HTTP 4318），Collector 常见端口 4317
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=milesai-api

# CORS（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
# 是否允许跨域携带凭证；本项目认证走 Bearer Header、不用 Cookie，保持 false
CORS_ALLOW_CREDENTIALS=false

# RAG / Embedding（详见 backend/.env.example）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_VECTOR_DIMENSION=768
# EMBEDDING_BACKEND=litellm
# EMBEDDING_LITELLM_MODEL=dashscope/text-embedding-v4
# EMBEDDING_LITELLM_API_KEY=
# EMBEDDING_VECTOR_DIMENSION=1024
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# 种子管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@local.dev
SEED_TENANT_NAME=默认租户
