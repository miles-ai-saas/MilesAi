# =============================================================================
# MilesAi 项目根目录环境变量（Docker Compose）
# 中间件：docker/docker-compose.middleware.yml
# 应用：  docker/docker-compose.yml
# 本地仅跑后端：backend/.env.example → backend/.env
# =============================================================================

# Compose 宿主机端口（可选）
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# WEAVIATE_PORT=8080
# API_PORT=8000
# WEB_PORT=3000
# ADMIN_WEB_PORT=3001
# FLOWER_PORT=5555
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000/api/admin/v1
# NEXT_PUBLIC_TENANT_WEB_URL=http://localhost:3000

# 应用
APP_NAME=MilesAi
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL（Compose 服务名）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=milesai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=milesai
MINIO_SECURE=false

# Weaviate
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# RAG / Embedding（详见 backend/.env.example）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIMENSION=384
# EMBEDDING_BACKEND=litellm
# EMBEDDING_LITELLM_MODEL=dashscope/text-embedding-v3
# EMBEDDING_LITELLM_API_KEY=
# EMBEDDING_VECTOR_DIMENSION=1024
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# 种子管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@local.dev
SEED_TENANT_NAME=默认租户
